---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { wanddekorationProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = wanddekorationProducts.find((p) => p.slug === "spiegel-beleuchtung")!;
const image = productImages[product.slug];
---

<Layout
  title="Spiegel mit Beleuchtung Schweiz | Wanddekoration | Inlux GmbH"
  description="Spiegel in Wunschmassen mit Rückbeleuchtung, Logogravur und Farboptionen. Individuell gefertigt — jetzt per WhatsApp anfragen."
  path="/wanddekoration/spiegel-beleuchtung"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/wanddekoration" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Wanddekoration
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">Spiegel</span> mit Beleuchtung
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Ein Standardspiegel spiegelt nicht immer den Charakter eines Raumes wider. Wir fertigen Spiegel in Sondergrössen und individuellem Design — für Wohnräume, Geschäfte und Salons, die einen eleganten, persönlichen Akzent setzen wollen.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="Spiegel mit Beleuchtung" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Personalisierung</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Wunschmasse statt Standardgrössen, bearbeitete (abgerundete) oder unbearbeitete (moderne, scharfe) Kanten, sowie Farboptionen von warmem Bronze-Rauchglas bis minimalistischem Standardglas. Auf Wunsch inklusive beleuchteter Namens- oder Logogravur.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Beleuchtung</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Licht hinter dem Spiegel schafft Tiefe und ein ausgeglichenes Raumlicht. Erhältlich mit Fernbedienung (Lichtfarbe und Helligkeit frei einstellbar) oder als günstigere Variante mit manueller Einstellung.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
