---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { wanddekorationProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = wanddekorationProducts.find((p) => p.slug === "mdf-paneele")!;
const image = productImages[product.slug];
---

<Layout
  title="MDF-Paneele Schweiz | Wanddekoration | Inlux GmbH"
  description="Dekorative MDF-Wandpaneele in Wunschmassen: über 6 Modelle, stossfest, einfache Montage. PDF-Katalog herunterladen oder per WhatsApp anfragen."
  path="/wanddekoration/mdf-paneele"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/wanddekoration" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Wanddekoration
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">MDF</span>-Paneele
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Dekorative MDF-Wandpaneele geben Innenräumen eine neue Atmosphäre — mit dezenten Profilstrukturen, die sich in fast jedem Bereich einsetzen lassen: Wohnräume, Büros, Cafés und Hotels. Die stossfesten Paneele werden nach dem Puzzle-Prinzip montiert und sind dadurch besonders einfach zu installieren.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="MDF-Paneele Wandgestaltung" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Modelle & Einsatz</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Über 6 Modelle mit unterschiedlichen Texturen und Farbskalen — für Innenräume geeignet, da das Material nicht für den Aussenbereich ausgelegt ist. Ob einzelne Akzentwand oder mehrere Bereiche: Die Paneele passen sich deinem Raumkonzept an.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Eigenschaften</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Stossfeste Konstruktion, hochwertiges und modernes Design. Die Soft-Touch-Oberfläche ist pflegeleicht und hinterlässt keine Fingerabdrücke — eine langlebige Alternative zu klassischer Wandfarbe oder Tapete.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
