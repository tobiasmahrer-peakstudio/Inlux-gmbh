---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { wanddekorationProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = wanddekorationProducts.find((p) => p.slug === "3d-wand")!;
const image = productImages[product.slug];
---

<Layout
  title="3D-Wand (PVC) Schweiz | Wanddekoration | Inlux GmbH"
  description="3D-Wandpaneele aus Polymermaterial: geometrische Designs, 3-7cm Stärke, einfache Montage. PDF-Katalog herunterladen oder per WhatsApp anfragen."
  path="/wanddekoration/3d-wand"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/wanddekoration" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Wanddekoration
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">3D</span>-Wand (PVC)
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Statt einer flachen Farbfläche schafft eine 3D-Wand eine echte plastische Struktur an der Wand. Gefertigt aus leichtem, hartem Polymermaterial mit 3–7 cm Stärke, mit Acrylfarbe farblich gestaltet — auf Wunsch auch in nicht brennbarer Ausführung.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="3D-Wandpaneele Gestaltung" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Modelle & Design</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Geometrische Muster, Ziegel-Optiken und individuelle Sonderanfertigungen — die Farbe wird mit Acryl- oder Wasserfarbe auf die getrocknete Oberfläche aufgetragen. Im Gegensatz zu 3D-Tapeten entsteht ein echtes, greifbares Relief.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Montage</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Zuerst wird ein Skelettsystem an der Wand verschraubt, anschliessend werden die Paneele darin eingesetzt und mit Silikon fixiert (Trockenzeit ca. 1 Stunde). Ein einfaches, bewährtes Verfahren für ein dauerhaftes Ergebnis.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
