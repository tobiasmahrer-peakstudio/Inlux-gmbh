---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { werbetechnikProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = werbetechnikProducts.find((p) => p.slug === "leuchtkasten")!;
const image = productImages[product.slug];
---

<Layout
  title="Leuchtkasten Schweiz | LED-Lightbox | Inlux GmbH"
  description="Leuchtkasten in Wunschmassen: ein- oder doppelseitig, UV-Druck oder Folie, hohe Druckqualität und gleichmässige LED-Beleuchtung. Jetzt per WhatsApp anfragen."
  path="/werbetechnik/leuchtkasten"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/werbetechnik" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Werbetechnik
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">Leuchtkasten</span>
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Ein Leuchtkasten ist eine beleuchtete Werbebox — bekannt als LED-Box oder beleuchtete Plexiglas-Box, bedruckt per UV-Druck oder Folie. Er verleiht deinem Standort bei Tag und Nacht Eleganz und Aufmerksamkeit.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="Leuchtkasten LED-Beleuchtung" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Modelle</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Ein- oder doppelseitig, hängend oder stehend montiert, sowie Sonderanfertigungen in individuellen Formen — passend für Schaufenster, Empfangsbereiche oder Fassaden.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Einsatzbereiche</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Ausstellungsräume, Einkaufszentren, Restaurants und Cafés, Hotels, Messen sowie Informationstafeln und Fassadenwerbung — dank einfacher Installation überall montierbar.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
