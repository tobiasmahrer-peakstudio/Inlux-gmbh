---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { werbetechnikProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = werbetechnikProducts.find((p) => p.slug === "wandausleger")!;
const image = productImages[product.slug];
---

<Layout
  title="Wandausleger Schweiz | Leuchtkasten für Fassaden | Inlux GmbH"
  description="Wandausleger mit LED-Beleuchtung: einseitig oder doppelseitig, über 50 Modelle, witterungsbeständig. PDF-Katalog herunterladen oder per WhatsApp anfragen."
  path="/werbetechnik/wandausleger"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/werbetechnik" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Werbetechnik
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">Wandausleger</span>
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Wandausleger sind für die vertikale Wandmontage konzipiert und dank LED-Beleuchtung ein echter Blickfang — bei Tag und bei Nacht. Sie steigern die Markenbekanntheit an stark frequentierten Standorten.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="Wandausleger mit Beleuchtung" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Modelle & Material</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Über 50 Modelle, einseitig oder doppelseitig für Sichtbarkeit aus beiden Richtungen, aus Chrom, Metall oder Acrylglas — das LED-System lässt sich in der gewünschten Struktur umsetzen.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Eigenschaften</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Einfache Montage, langlebige Outdoor-Materialien, witterungsbeständig gegen Regen, Wind und Sonne — konzipiert für 24/7-Betrieb bei Tag und Nacht.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
