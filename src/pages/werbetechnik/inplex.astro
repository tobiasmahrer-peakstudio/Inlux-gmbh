---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { werbetechnikProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = werbetechnikProducts.find((p) => p.slug === "inplex")!;
const image = productImages[product.slug];
---

<Layout
  title="Inplex Schweiz | Wirtschaftliche Werbetafel | Inlux GmbH"
  description="Inplex: erschwingliche Werbelösung in 2cm oder 4cm Stärke, 9 Farben, einfach zu montieren. Jetzt per WhatsApp anfragen."
  path="/werbetechnik/inplex"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/werbetechnik" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Werbetechnik
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">Inplex</span>
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Eine effektive und erschwingliche Werbelösung für hohe Sichtbarkeit — in den Stärken 2 cm und 4 cm, in neun Farben, einfach zu montieren und sowohl innen als auch aussen mit Firmenlogo oder Wunschschriftzug einsetzbar.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="Inplex Werbetafel" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Merkmale</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Wirtschaftlicher als viele andere Werbeprodukte, attraktiv durch verschiedene Farben und Designs, langlebig dank hochwertiger Materialien.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Einsatzmöglichkeiten</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Als Aushängeschild, Werbetafel oder Wegweiser am Eingang, als Dekoration in Hotels, Restaurants und Cafés — oder für besondere Anlässe und Veranstaltungen.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
