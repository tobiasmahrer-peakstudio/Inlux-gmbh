---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDetailCTA from "../../components/ProductDetailCTA.astro";
import { werbetechnikProducts } from "../../data/site";
import { productImages } from "../../data/productImages";

const product = werbetechnikProducts.find((p) => p.slug === "lightbox-drehmotor")!;
const image = productImages[product.slug];
---

<Layout
  title="Lightbox mit Drehmotor Schweiz | Inlux GmbH"
  description="Lightbox mit Drehmotor: wirtschaftliche, auffällige Aussenwerbung mit rotierendem Werbeträger, LED-Beleuchtung und Fernbedienung. Jetzt per WhatsApp anfragen."
  path="/werbetechnik/lightbox-drehmotor"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
    <a href="/werbetechnik" class="text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-neon)]">
      ← Zurück zu Werbetechnik
    </a>
    <h1 class="mt-4 text-3xl font-extrabold sm:text-5xl">
      <span class="glow-text">Lightbox</span> mit Drehmotor
    </h1>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-muted)]">
      Um die Sichtbarkeit deines Geschäfts zu erhöhen und deine Markenidentität effektiv zu präsentieren, ist die Lightbox mit Drehmotor die perfekte Lösung — mit modernem, ästhetischem Design für jede Tageszeit.
    </p>

    {image && (
      <div class="glow-border mt-10 overflow-hidden rounded-2xl">
        <Image src={image} alt="Lightbox mit Drehmotor" width={1000} height={625} class="aspect-[8/5] w-full object-cover" />
      </div>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Langlebigkeit & Effizienz</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Hochwertige, witterungsbeständige Materialien für den Aussenbereich, LED-Beleuchtung für niedrige Wartungskosten und Energieeffizienz.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[var(--color-text)]">Anpassung & Bedienung</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          Verschiedene Farb-, Grössen- und Designoptionen, einfache Montage sowie Fernbedienung für Beleuchtungsintensität und Drehgeschwindigkeit.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    <ProductDetailCTA whatsappMessage={product.whatsappMessage} pdfUrl={product.pdfUrl} />
  </section>
</Layout>
