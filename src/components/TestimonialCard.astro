---
import type { Testimonial } from "../data/site";

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure class="glow-border flex h-full flex-col rounded-2xl bg-[var(--color-surface)] p-6">
  <blockquote class="flex-1 text-sm leading-relaxed text-[var(--color-text)]">
    "{testimonial.quote}"
  </blockquote>
  <figcaption class="mt-4 text-sm">
    <span class="font-semibold text-[var(--color-text)]">{testimonial.name}</span>
    <span class="text-[var(--color-muted)]"> — {testimonial.company}</span>
  </figcaption>
</figure>
