---
import { processSteps } from "../data/site";

const icons = [
  // Beratung — chat bubble
  `<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4 4v-4H6.5A2.5 2.5 0 0 1 4 13.5v-8Z"/><circle cx="8.5" cy="9.5" r=".9" fill="currentColor" stroke="none"/><circle cx="12" cy="9.5" r=".9" fill="currentColor" stroke="none"/><circle cx="15.5" cy="9.5" r=".9" fill="currentColor" stroke="none"/>`,
  // Entwurf — pencil
  `<path d="M3 21l.9-3.6L15.5 5.8a2 2 0 0 1 2.8 0l1.9 1.9a2 2 0 0 1 0 2.8L8.6 22.1 5 23l-2-2Z"/><path d="M13.5 8l3 3"/>`,
  // Herstellung — factory
  `<path d="M3 21V10.5l5 3.5v-3.5l5 3.5v-3.5l5 3.5V21H3Z"/><path d="M8 21v-4M13 21v-4M18 21v-4M3 21h18"/>`,
  // Montage — wrench
  `<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2 2.6-2.6Z"/>`,
];
---

<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {processSteps.map((step, i) => (
    <li class="glow-border rounded-2xl bg-[var(--color-surface)] p-6">
      <span class="glow-border flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-surface-2)]">
        <svg
          viewBox="0 0 24 24"
          class="h-7 w-7 text-[var(--color-neon)]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={icons[i]}
        />
      </span>
      <p class="mt-4 font-semibold text-[var(--color-text)]">{step.title}</p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{step.description}</p>
    </li>
  ))}
</ol>
